{
    "security.workspace.trust.untrustedFiles": "newWindow",
    "security.allowedUNCHosts": [
        "wsl.localhost"
    ],
    "files.associations": {
        "*.json.tmpl": "jsonc",
        "*.conf.tmpl": "properties",
        "config.tmpl": "ssh_config"
    },
    "workbench.colorTheme": "GitHub Dark Dimmed",
    "workbench.iconTheme": "material-icon-theme",
    "editor.fontFamily": "'Fira Code Retina', 'Fira Code', 'MesloLGS Nerd Font', Consolas, monospace",
    "editor.fontSize": 15,
    "editor.fontLigatures": true,
    "terminal.integrated.fontFamily": "MesloLGS Nerd Font Mono",
    "terminal.integrated.fontLigatures.enabled": true,
    "git.autofetch": true,
    "git.confirmSync": false,
    "git.enableSmartCommit": true,
    "remote.SSH.connectTimeout": 20,
    "remote.SSH.remotePlatform": {
        "myHair": "linux",
        "myWaist": "linux",
        "aspire": "linux",
        "mySkull": "linux",
        "snf-878237.vm.okeanos.grnet.gr": "linux",
        "10.2.110.175": "linux"
    },
    "dart.flutterSdkPath": "{{ .chezmoi.homeDir }}/AppData/Local/SDKs/flutter",
    "[json]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    },
    "[jsonc]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    },
    "[html]": {
        "editor.defaultFormatter": "vscode.html-language-features"
    },
    "[latex]": {
        "editor.defaultFormatter": "James-Yu.latex-workshop"
    },
    "[markdown]": {
        "editor.defaultFormatter": "yzhang.markdown-all-in-one"
    },
    "[dockercompose]": {
        "editor.defaultFormatter": "ms-azuretools.vscode-docker"
    },
    "[python]": {
        "editor.formatOnType": true
    },
    "cSpell.userWords": [
        "flowgraph"
    ],
    "github.copilot.enable": {
        "*": true,
        "plaintext": false,
        "markdown": false,
        "scminput": false
    },
    "lean4.alwaysAskBeforeInstallingLeanVersions": true,
    "@azure.argTenant": "",
    "chat.hookFilesLocations": {
        ".github/hooks": true,
        ".claude/settings.local.json": true,
        ".claude/settings.json": true,
        "~/.copilot/hooks": true,
        "~/.claude/settings.json": true,
        "~/.agents/hooks": true
    },
    "chat.viewSessions.orientation": "stacked",
    "terminal.integrated.commandsToSkipShell": [
        "matlab.interrupt"
    ]
}

